# Settings for the HTTPS stack (docker-compose.https.yml).
# Copy to .env in this directory - compose reads .env automatically:
#   cp .env.https.example .env

# Host port HTTPS is published on. The UI lives at https://<host>:<HTTPS_PORT>/
HTTPS_PORT=8443

# Host port for the app's plain HTTP listener. Bound to 127.0.0.1 in the HTTPS
# stack, so it is reachable only from the machine running Docker - HTTPS is the
# way in from anywhere else.
PORT=8000

# Subject of the generated self-signed certificate.
TLS_COMMON_NAME=localhost

# Every name and address you will use in the browser must be listed here, or the
# certificate will not match and the browser will warn on every visit. Add the
# LAN address of the Docker host alongside the loopback entries.
TLS_SAN=DNS:localhost,IP:127.0.0.1,IP:192.168.1.99

# The certificate is generated once, on first boot, into ./certs. After changing
# TLS_SAN or TLS_COMMON_NAME, delete it so a new one is minted:
#   docker compose -f docker-compose.https.yml down
#   rm -rf certs
#   docker compose -f docker-compose.https.yml up -d

# Extra `poly-chatterbox serve` flags, e.g. --preload (all models) or --preload turbo,multilingual.
POLY_CHATTERBOX_SERVE_ARGS=

# How many models stay loaded at once (original, turbo, nano, multilingual, vc); 3 fits a 16 GB GPU.
POLY_CHATTERBOX_MAX_LOADED_MODELS=3
# Multilingual checkpoint when a request doesn't choose one: v3 (recommended) or v2.
POLY_CHATTERBOX_MULTILINGUAL_VERSION=v3
# Long text is split at sentences into chunks of at most this many characters.
POLY_CHATTERBOX_MAX_CHUNK_CHARS=300

# Where saved prompts are kept: the default is a Docker volume named "prompts". Set a folder
# (e.g. ./prompts) to keep them on the host instead, so you can edit, back up or share them.
PROMPTS_DIR=prompts

# Optional Hugging Face token for faster, rate-limit-free downloads.
HF_TOKEN=
