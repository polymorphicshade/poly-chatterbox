# Settings for the plain HTTP stack (docker-compose.yml).
# Copy to .env and adjust; docker compose reads it automatically. For HTTPS, start from
# .env.https.example instead.

# Host port the app is published on. The UI lives at http://<host>:<PORT>/
PORT=8000

# Extra `poly-chatterbox serve` flags, e.g. --preload (all models) or --preload turbo,multilingual.
POLY_CHATTERBOX_SERVE_ARGS=

# How many models stay loaded at once (original, turbo, nano, multilingual, vc); 3 fits a 16 GB GPU.
POLY_CHATTERBOX_MAX_LOADED_MODELS=3
# Multilingual checkpoint when a request doesn't choose one: v3 (recommended) or v2.
POLY_CHATTERBOX_MULTILINGUAL_VERSION=v3
# Long text is split at sentences into chunks of at most this many characters.
POLY_CHATTERBOX_MAX_CHUNK_CHARS=300

# Where saved prompts are kept: the default is a Docker volume named "prompts". Set a folder
# (e.g. ./prompts) to keep them on the host instead, so you can edit, back up or share them.
PROMPTS_DIR=prompts

# Optional Hugging Face token for faster, rate-limit-free downloads.
HF_TOKEN=
